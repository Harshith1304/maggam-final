# --- Studio (owner login) -------------------------------------------------
# The password you type at /admin/login. Make it long.
ADMIN_PASSWORD=
# Any long random text (32+ characters). Signs your login cookie.
SESSION_SECRET=

# --- Optional -------------------------------------------------------------
# Link back to your portfolio (shown in header + footer). Leave empty to hide it.
NEXT_PUBLIC_PORTFOLIO_URL=
# Public address of this blog.
NEXT_PUBLIC_SITE_URL=
# Where comments/likes are stored (default: ./data). Point at a persistent disk in production.
# DATA_DIR=
# Where threads are stored (default: ./content/threads).
# CONTENT_DIR=

# --- Vercel edition (free database) ---------------------------------------
# Added for you by Vercel when you connect an Upstash Redis database to the project (as KV_REST_API_URL and
# KV_REST_API_TOKEN, or UPSTASH_REDIS_REST_URL and UPSTASH_REDIS_REST_TOKEN). The site uses the database when it
# runs on Vercel, and plain files everywhere else.
# To copy your data up (npm run push) or back down (npm run pull) from your own computer, put the same two values
# in your .env.local. Your local site keeps using files; they are only used by those two commands.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# Force the database on a server that is not Vercel:  MAGGAM_STORAGE=remote
